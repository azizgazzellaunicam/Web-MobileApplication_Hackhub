{
  "name": "hackhub-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:identity": "node src/identity-server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-lines=90 \"test/*.test.js\"",
    "test:identity": "node --test --test-concurrency=1 test/refresh-token-repository.test.js test/session-repository.test.js test/event-relay.test.js",
    "db:migrate:sqlite": "node scripts/migrate-sqlite-to-mariadb.js"
  },
  "dependencies": {
    "amqplib": "^2.4.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.15.3",
    "ms": "^2.1.3"
  }
}
